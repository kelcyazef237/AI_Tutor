# Copy to .env and adjust. Never commit real secrets.
# HOST: 127.0.0.1 = loopback only. Use 0.0.0.0 to expose the production
# server (single-port mode) on your LAN / Wi-Fi, e.g. http://192.168.x.x:8787.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
LOG_LEVEL=info
# WEB_DIST=false  # uncomment for API-only mode (no frontend serving)
# CORS_ORIGIN=http://192.168.1.20:5173  # extra dev origin for phone testing over LAN
